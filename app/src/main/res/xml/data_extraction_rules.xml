<?xml version="1.0" encoding="utf-8"?>
<!--
  v1 stores only settings (server URL, cleanup, language) and nothing else is written to disk at
  all: no audio, no transcripts, no model state (D-012). So the rule is "exclude everything" — the
  server URL is not worth syncing and there is nothing else to sync.

  Android 12+ deprecated android:allowBackup in favour of this file; both are set so the intent is
  unambiguous on old and new versions.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
