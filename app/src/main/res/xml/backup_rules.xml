<?xml version="1.0" encoding="utf-8"?>
<!--
  The pre-Android-12 half of the same rule as data_extraction_rules.xml: exclude everything.
  v1 writes nothing to disk but its own settings, and android:allowBackup is already false — this
  exists so minSdk 30 devices get the same explicit statement rather than the framework default.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
