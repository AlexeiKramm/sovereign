<?xml version="1.0" encoding="utf-8"?>
<!--
  Sovereign brand logo (full colour): the obsidian launcher gradient disc with the white
  3-Tier Dreadnought stencil. Derived from ic_launcher_background.xml + ic_launcher_foreground.xml
  so the About card, the app icon and the notification mark stay visually consistent.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Obsidian gradient disc -->
    <path
        android:pathData="M54,0 C83.8,0 108,24.2 108,54 C108,83.8 83.8,108 54,108 C24.2,108 0,83.8 0,54 C0,24.2 24.2,0 54,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#1C232E" />
                <item android:offset="0.6" android:color="#10141C" />
                <item android:offset="1.0" android:color="#07090C" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle inner bevel -->
    <path
        android:pathData="M54,0 C83.8,0 108,24.2 108,54 C108,83.8 83.8,108 54,108 C24.2,108 0,83.8 0,54 C0,24.2 24.2,0 54,0 Z"
        android:strokeColor="#1CFFFFFF"
        android:strokeWidth="1.5"
        android:fillColor="#00000000" />

    <!-- Sovereign 3-Tier Dreadnought Stencil (6.0px Calibrated Trench) -->
    <!-- Tier 1: Apex Needles -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 52.08,24.88 L 52.08,51.12 L 42.48,51.12 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 55.92,24.88 L 65.52,51.12 L 55.92,51.12 Z" />

    <!-- Tier 2: Mid Flared Ribs -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 52.08,53.04 L 41.52,53.04 L 38.64,60.08 L 52.08,67.12 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 55.92,53.04 L 55.92,67.12 L 69.36,60.08 L 66.48,53.04 Z" />

    <!-- Tier 3: Lower Keel Plates -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 52.08,69.04 L 39.92,62.64 L 52.08,77.36 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 55.92,69.04 L 55.92,77.36 L 68.08,62.64 Z" />

    <!-- Bottom Keel Diamond Tip -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 52.08,78.96 L 54.0,83.12 L 55.92,78.96 L 54.0,77.36 Z" />
</vector>
