<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- The phone-server holds a foreground service for its whole life; `specialUse` is the idle
         type (Android 15+ caps `dataSync` at 6h/24h). See docs/work/phone-server-desktop/PLAN.md. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Model downloads run as a foreground dataSync worker so they survive leaving the app. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- The download progress notification is only visible when this is granted; denied is not
         fatal (the download still runs, just invisibly). Requested on the first download tap. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.Sovereign"
        android:enableOnBackInvokedCallback="true"
        android:largeHeap="true"
        android:usesCleartextTraffic="true">
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />
        <uses-native-library
            android:name="libGLES_mali.so"
            android:required="false" />

        <!-- Shares the benchmark CSV via the system share sheet; scoped to this app's files dir. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- usesCleartextTraffic is deliberate: the stack is plain HTTP on the LAN/Tailscale and
             carries no auth in v1 (server CONTRACT.md §6). It is a documented deployment
             assumption, not a security feature. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".floating.VoiceAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true"
            android:label="@string/accessibility_service_name">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".floating.FloatingOverlayService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Phone-as-desktop-server (Chunk 1b). Held `specialUse | microphone` for its whole life:
             Android 14+ will not grant a while-in-use `microphone` type to a background app, so the
             type is acquired while an Activity is visible and kept until the server stops. -->
        <service
            android:name=".server.SovereignServerService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Serves on-device dictation to a paired desktop client over the LAN" />
        </service>

        <!-- WorkManager's foreground service carries the download notification. WorkManager does
             not declare a foregroundServiceType of its own, and a targetSdk 34+ app must, or the
             foreground service throws when it starts. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>

</manifest>
