<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Server tier only in v1: audio is recorded on the device and uploaded, nothing is
         transcribed locally (PLAN §14). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.SmartVoice"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic is deliberate: the stack is plain HTTP on the LAN/Tailscale and
             carries no auth in v1 (server CONTRACT.md §6). It is a documented deployment
             assumption, not a security feature. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
